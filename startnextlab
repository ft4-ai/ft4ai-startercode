#!/usr/bin/env python3
"""
startnextlab: Start the next lab by copying in its starter code.
Usage:
  startnextlab           # preview + prompt
  startnextlab -y        # yes, no prompt
  startnextlab -n        # dry-run only
  startnextlab --status  # show next lab & count

This tool updates the `.labs_started` file, and will abort 
if labs have been started without recording them in it.
"""
import argparse
import sys
import shutil
import filecmp
import re
import subprocess
from pathlib import Path
from datetime import datetime, date

# Paths and constants
ROOT         = Path.cwd()
STARTER_ROOT = ROOT / '.labstartercode'
LEDGER_FILE  = ROOT / '.labs_started'
LABNOTES_DIR   = ROOT / 'labnotes'

# Exit codes
EXIT_OK       = 0
EXIT_FAIL     = 1
EXIT_CONFLICT = 2
EXIT_ABORT    = 3

def error(msg, code=EXIT_FAIL):
    print(f"ERROR: {msg}")
    sys.exit(code)

# --- CLI args ---
parser = argparse.ArgumentParser(description="Start the next lab")
parser.add_argument('-n', '--dry-run', action='store_true',
                    help='Show files to be added, then exit')
parser.add_argument('-y', '--yes', action='store_true',
                    help='Skip confirmation prompt')
parser.add_argument('--status', action='store_true',
                    help='Show next lab and file count, then exit')
args = parser.parse_args()

# --- Validation Phase ---

# 1. Ensure workspace looks right
if not STARTER_ROOT.is_dir():
    error(f"{STARTER_ROOT} not found. Did you git clone the entire repo?")

# 2. Read or init ledger
if LEDGER_FILE.exists():
    started = [line.strip() for line in LEDGER_FILE.read_text().splitlines() if line.strip()]
else:
    started = []
# Ledger sanity
valid_labs = sorted([d.name for d in STARTER_ROOT.iterdir() if d.is_dir()])
for lab in started:
    if lab not in valid_labs:
        error(f"Unknown lab in ledger: {lab!r}. Remove it to continue.")

# 3. Determine next_lab
next_lab = None
for lab in valid_labs:
    if lab not in started:
        next_lab = lab
        break
if next_lab is None:
    print("All available labs already started. You can check for new labs via:\n  git pull")
    sys.exit(EXIT_OK)

## Change "unitX.labY" to "Unit X Lab Y"
# lab_str = re.sub(r'(?i)\b(unit|lab)(\d+)\b', 
#                  lambda m: f"{m.group(1).title()} {m.group(2)}",
#                  next_lab).replace('.', ' ')
lab_str = next_lab # Just use "unitX.labY" format

# 4. Gather stubs for next_lab
stub_dir = STARTER_ROOT / next_lab
if not stub_dir.exists():
    # Empty-lab support: if dir missing, it's an error
    error(f"No stubs directory for {next_lab!r} at {stub_dir!r}; this should never happen.")
stubs = [p for p in stub_dir.rglob('*') if p.is_file()]

# 5. Compute destinations (stubs + report)
dest_files = []
# Stubs → project root
for src in stubs:
    rel = src.relative_to(stub_dir)
    dest = ROOT / rel
    dest_files.append(dest)
# Always add report
labnotes_file = LABNOTES_DIR / f"{next_lab}.notes.md"
dest_files.append(labnotes_file)

# --status mode?
if args.status:
    print(f"Next lab: {lab_str} ({len(stubs)} starter files)")
    sys.exit(EXIT_OK)

# 6. Conflict check
for src in stubs:
    rel  = src.relative_to(stub_dir)
    dest = ROOT / rel
    if dest.exists():
        # Compare contents
        try:
            same = filecmp.cmp(str(src), str(dest), shallow=False)
        except Exception:
            # Fallback to byte compare
            same = src.read_bytes() == dest.read_bytes()
        if not same:
            error(
                f"Won't overwrite modified file: {dest!r}\n"
                "Delete or revert it to retry.",
                code=EXIT_CONFLICT
            )

# 7. Dry-run?
if args.dry_run:
    print(f"To start the next lab: {lab_str}, \nthese files will be created ({len(dest_files)}):")
    for f in dest_files:
        print("  " + str(f))
    sys.exit(EXIT_OK)

# --- Commit Phase ---

# 8. Prompt (unless -y)
if not args.yes:
    print(f"Starting the next lab: {lab_str}")
    print(f"These files will be created ({len(dest_files)}):")
    for f in dest_files:
        print("  " + str(f))
    ans = input("Proceed? (Y/n) ").strip().lower()
    if ans in ('n', 'no'):
        sys.exit(EXIT_ABORT)

# 9. Copy stub files
for src in stubs:
    rel  = src.relative_to(stub_dir)
    dest = ROOT / rel
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dest)

# 10. Append ledger
with open(LEDGER_FILE, 'a') as lf:
    lf.write(next_lab + "\n")

# 11. Generate report
LABNOTES_DIR.mkdir(exist_ok=True)
name  = subprocess.run(['git','config','user.name'], stdout=subprocess.PIPE, text=True).stdout.strip()
email = subprocess.run(['git','config','user.email'], stdout=subprocess.PIPE, text=True).stdout.strip()
today = date.today().isoformat()
with open(labnotes_file, 'w') as rf:
    # Convert unit#/lab# anywhere in the string
    # Turn dot separators into spaces; leave everything else verbatim
    rf.write(f"# Lab Notes: {lab_str}\n")
    if name or email:
        rf.write(f"## {name} {email}\n")
    rf.write(f"## Started {today}\n\n")
    rf.write("*TODO Record your answers, results, and notes here.*\n")

print(f"{lab_str} started.\nLab Notebook created at '{labnotes_file!s}'.")

